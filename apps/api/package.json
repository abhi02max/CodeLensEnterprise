{
  "name": "@codelens/api",
  "version": "0.1.0",
  "private": true,
  "description": "CodeLens Enterprise REST API, review orchestration and background workers",
  "main": "dist/main.js",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "start:prod": "node dist/main.js",
    "worker": "node dist/worker.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@codelens/validation-broker": "workspace:*",
    "@codelens/validation-executor": "workspace:*",
    "@codelens/sandbox-broker": "workspace:*",
    "@codelens/patch-core": "workspace:*",
    "@codelens/ai-agent": "workspace:*",
    "@codelens/database": "workspace:*",
    "@codelens/github": "workspace:*",
    "@codelens/rag-engine": "workspace:*",
    "@codelens/shared": "workspace:*",
    "@codelens/static-analysis": "workspace:*",
    "@nestjs/bullmq": "^11.0.2",
    "@nestjs/common": "^11.0.9",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.9",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.9",
    "@nestjs/swagger": "^11.0.3",
    "@nestjs/throttler": "^6.4.0",
    "bcryptjs": "2.4.3",
    "bullmq": "^5.34.10",
    "cookie-parser": "1.4.7",
    "helmet": "8.0.0",
    "ioredis": "5.4.2",
    "passport": "0.7.0",
    "passport-jwt": "4.0.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1",
    "zod": "3.24.1",
    "zod-to-json-schema": "3.24.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.2",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.9",
    "@types/bcryptjs": "2.4.6",
    "@types/cookie-parser": "1.4.8",
    "@types/express": "5.0.0",
    "@types/node": "22.10.5",
    "@types/passport-jwt": "4.0.1",
    "typescript": "5.7.3",
    "vitest": "2.1.8"
  }
}
