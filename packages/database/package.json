{
  "name": "@codelens/database",
  "version": "0.1.0",
  "private": true,
  "description": "Prisma schema, client and tenant-scoping middleware for CodeLens Enterprise",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "prisma"
  ],
  "scripts": {
    "generate": "prisma generate",
    "validate": "dotenv -e ../../.env -- prisma validate",
    "build": "prisma generate && tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate": "dotenv -e ../../.env -- prisma migrate dev",
    "migrate:deploy": "dotenv -e ../../.env -- prisma migrate deploy",
    "init:container": "tsx scripts/init-database.ts",
    "studio": "dotenv -e ../../.env -- prisma studio",
    "seed": "dotenv -e ../../.env -- tsx prisma/seed.ts",
    "seed:container": "tsx prisma/seed.ts",
    "reset:demo": "dotenv -e ../../.env -- tsx scripts/reset-demo.ts",
    "reset:demo:container": "tsx scripts/reset-demo.ts",
    "verify:vector": "dotenv -e ../../.env -- tsx scripts/verify-vector-setup.ts",
    "test:lifecycle": "tsx --test test/schema-compatibility.test.ts test/conversation-migration.test.ts test/investigation-migration.test.ts test/collaborator-migration.test.ts test/exact-revision-migration.test.ts test/patch-migration.test.ts test/application-migration.test.ts test/validation-migration.test.ts",
    "test": "pnpm test:lifecycle",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "prisma": {
    "seed": "dotenv -e ../../.env -- tsx prisma/seed.ts"
  },
  "dependencies": {
    "@codelens/shared": "workspace:*",
    "@prisma/client": "6.2.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "bcryptjs": "2.4.3",
    "dotenv-cli": "7.4.4",
    "prisma": "6.2.1",
    "tsx": "4.19.2",
    "typescript": "5.7.3"
  }
}
