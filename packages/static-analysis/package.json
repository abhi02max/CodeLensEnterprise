{
  "name": "@codelens/static-analysis",
  "version": "0.1.0",
  "private": true,
  "description": "ESLint, Semgrep, npm audit and complexity analysis with ML feature extraction",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "test": "vitest run"
  },
  "dependencies": {
    "@codelens/shared": "workspace:*"
  },
  "devDependencies": {
    "typescript": "5.7.3",
    "vitest": "2.1.8"
  }
}
