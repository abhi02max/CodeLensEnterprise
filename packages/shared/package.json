{
  "name": "@codelens/shared",
  "version": "0.1.0",
  "private": true,
  "description": "Shared contracts, enums, constants and pure domain logic for CodeLens Enterprise",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "3.24.1"
  },
  "devDependencies": {
    "typescript": "5.7.3",
    "vitest": "2.1.8"
  }
}
