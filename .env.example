# ==========================================================================
# CodeLens Enterprise - Docker Compose environment template
# Copy to `.env` at the repo root before starting Compose.
# Never commit `.env`. Rotate every secret before any shared deployment.
# ==========================================================================

# REQUIRED FOR CORE LOCAL STACK --------------------------------------------
# Compose uses production process mode. Keep NODE_ENV=development in this file
# for explicit demo commands; Compose overrides it in API and worker containers.
NODE_ENV=development
LOG_LEVEL=debug

# ---------------------------------------------------------------- database
# Host port 5433 avoids clashing with a local Postgres on 5432.
POSTGRES_USER=codelens
POSTGRES_PASSWORD=codelens_dev_password
POSTGRES_DB=codelens
POSTGRES_PORT=5433
# Keep this host URL for local Prisma scripts. Compose overrides DATABASE_URL
# inside containers. Use a URL-safe (for example, hex) POSTGRES_PASSWORD: Compose
# uses this same value in both the database password and the connection URL.
DATABASE_URL=postgresql://codelens:codelens_dev_password@localhost:5433/codelens?schema=public

# ---------------------------------------------------------------- redis
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------- api
API_PORT=4000
WEB_PORT=3000
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------- auth
# Generate independently: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_me_with_48_random_bytes_hex
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=replace_me_with_a_different_48_random_bytes_hex
JWT_REFRESH_TTL=30d

# AES-256-GCM key for encrypting stored GitHub tokens at rest.
# Must be exactly 32 bytes hex-encoded (64 hex chars):
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=replace_me_with_32_random_bytes_hex_64_characters_long_exactly

# OPTIONAL INTEGRATION ------------------------------------------------------
# GitHub sign-in/import and webhook handling need these credentials.
# github.com/settings/developers -> New OAuth App
# Homepage URL:        http://localhost:3000
# Callback URL:        http://localhost:4000/api/v1/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:4000/api/v1/auth/github/callback
# Scopes: read:user + user:email for identity, repo for private repo diffs.
GITHUB_OAUTH_SCOPES=read:user,user:email,repo
# Random secret for verifying inbound webhook HMAC signatures.
GITHUB_WEBHOOK_SECRET=

# OPTIONAL AI PROVIDER ------------------------------------------------------
# Without a provider key, static analysis and ML still run; AI review is skipped.
# Set the provider you intend to use; the rest can stay blank.
AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini
AI_MAX_OUTPUT_TOKENS=8000
AI_TEMPERATURE=0.2
# Hard ceiling per review run. Runs stop and record partial results past this.
AI_MAX_COST_CENTS_PER_RUN=50

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# OPTIONAL AI PROVIDER - embeddings / RAG ----------------------------------
# Without a usable embedding provider, repository indexing is unavailable.
# openai | local  (local uses sentence-transformers via the ML service)
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
# Must match the vector(N) dimension in the Prisma schema.
# text-embedding-3-small = 1536, all-MiniLM-L6-v2 = 384
EMBEDDING_DIMENSIONS=1536
RAG_CHUNK_MAX_TOKENS=800
RAG_TOP_K=12
RAG_MMR_LAMBDA=0.7
RAG_MAX_CONTEXT_TOKENS_PER_FILE=4000
RAG_MAX_INDEXED_FILES=2000

# pgvector is the supported Compose path. Qdrant is an optional profile, but
# the current RAG implementation uses pgvector.
VECTOR_STORE=pgvector
QDRANT_URL=http://localhost:6333
QDRANT_PORT=6333
QDRANT_API_KEY=
QDRANT_COLLECTION=codelens_chunks

# DEMO/DEVELOPMENT ---------------------------------------------------------
# The ML container trains its bundled model at image build time.
ML_SERVICE_PORT=8000
ML_SERVICE_URL=http://localhost:8000
ML_SERVICE_TIMEOUT_MS=15000
ML_ARTIFACTS_DIR=./artifacts
# Minimum labeled PRs before an org gets its own retrained model.
ML_MIN_SAMPLES_FOR_ORG_MODEL=200
ENABLE_LOCAL_EMBEDDINGS=false
LOCAL_EMBEDDING_MODEL=all-MiniLM-L6-v2
SHAP_BACKGROUND_SIZE=100

# ---------------------------------------------------------------- static analysis
STATIC_ANALYSIS_TMP_DIR=./.codelens-tmp
STATIC_ANALYSIS_TIMEOUT_MS=120000
ENABLE_ESLINT=true
ENABLE_SEMGREP=true
ENABLE_NPM_AUDIT=true
SEMGREP_RULESETS=p/security-audit,p/owasp-top-ten
SEMGREP_BIN=semgrep

# ---------------------------------------------------------------- queue
# Namespaces the BullMQ keys, so one Redis can host several environments without one
# deployment's workers picking up another's jobs.
QUEUE_PREFIX=codelens
QUEUE_CONCURRENCY=4
QUEUE_MAX_ATTEMPTS=3
SHUTDOWN_DRAIN_MS=180000
# Must exceed SHUTDOWN_DRAIN_MS plus the 10-second cleanup budget.
SHUTDOWN_GRACE_PERIOD=200s
# Compose overrides this to false and starts the dedicated worker service.
# true remains useful for host-run development with `pnpm dev:api`.
RUN_WORKERS_IN_API=true

# ---------------------------------------------------------------- observability
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ---------------------------------------------------------------- web
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_APP_NAME=CodeLens Enterprise
